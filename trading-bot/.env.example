# ── Binance API ────────────────────────────────────────────────────────────────
# Créez vos clés sur : https://www.binance.com/fr/my/settings/api-management
# IMPORTANT : activez uniquement "Spot & Margin Trading" — JAMAIS les retraits !
BINANCE_API_KEY=votre_api_key_ici
BINANCE_API_SECRET=votre_api_secret_ici

# Mettre à true pour utiliser le testnet (https://testnet.binance.vision)
USE_TESTNET=false

# ── Capital & Paire ────────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
QUOTE_ASSET=USDT
TRADE_AMOUNT_PCT=10       # % du capital disponible utilisé par trade
MAX_OPEN_TRADES=1

# ── Risk Management ────────────────────────────────────────────────────────────
STOP_LOSS_PCT=2           # Couper la perte à -2%
TAKE_PROFIT_PCT=4         # Prendre profit à +4%

# ── Indicateurs ────────────────────────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=30           # Signal achat sous cette valeur
RSI_OVERBOUGHT=70         # Signal vente au-dessus de cette valeur
EMA_FAST=9
EMA_SLOW=21

# ── Bougies ────────────────────────────────────────────────────────────────────
# Valeurs possibles : 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d
CANDLE_INTERVAL=15m
CANDLE_LIMIT=100

# ── Comportement du bot ────────────────────────────────────────────────────────
PAPER_TRADING=true        # IMPORTANT : mettre false uniquement en production !
PAPER_BALANCE=1000        # Capital fictif en USDT pour le paper trading
LOOP_INTERVAL_MS=60000    # Intervalle entre analyses en ms (60000 = 1 minute)
LOG_LEVEL=info            # info | debug
